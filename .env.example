POSTGRES_PASSWORD=replace-with-a-long-random-value
MEMORY_DOMAIN=memory.example.com
# JSON object mapping each approved Space UUID to the SHA-256 of its exact
# startup use_when cue. Keep this host-owned and out of repository config.
ZESTMEM_STARTUP_CUE_APPROVALS=
OIDC_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
# Entra v2 access tokens use the resource application's client-ID GUID in aud.
OIDC_AUDIENCE=YOUR_MEMORY_API_APP_ID
OIDC_SUBJECT_CLAIM=sub
OIDC_REQUIRED_ROLE=
OIDC_SCOPES=
MCP_RESOURCE_URI=https://memory.example.com/mcp
MCP_RESOURCE_METADATA_URL=

# Optional native browser OIDC. The public origin and redirect must be exact.
# Leave the origin empty for direct loopback HTTP. Set it to the exact external
# HTTPS origin whenever a reverse proxy serves the console.
CONSOLE_PUBLIC_ORIGIN=
CONSOLE_OIDC_ISSUER=
CONSOLE_OIDC_CLIENT_ID=
# Set at most one of the inline secret and secret-file path.
CONSOLE_OIDC_CLIENT_SECRET=
CONSOLE_OIDC_CLIENT_SECRET_FILE=
CONSOLE_OIDC_REDIRECT_URL=
CONSOLE_OIDC_SCOPES="openid profile"
CONSOLE_OIDC_SUBJECT_CLAIM=sub
CONSOLE_OIDC_REQUIRED_ROLE=
CONSOLE_AUTH_RATE_LIMIT_PER_MINUTE=30
CONSOLE_AUTH_RATE_LIMIT_BURST=10

# Optional trusted-edge browser assertion mode.
CONSOLE_ASSERTION_ISSUER=
CONSOLE_ASSERTION_AUDIENCE=
CONSOLE_ASSERTION_JWKS_URL=
CONSOLE_ASSERTION_SUBJECT_CLAIM=sub
CONSOLE_ASSERTION_REQUIRED_ROLE=
CONSOLE_ASSERTION_HEADER=Cf-Access-Jwt-Assertion
BACKUP_RETENTION_DAYS=14
# Optional encrypted off-site backups. Use a private repository and a fine-grained
# token limited to Contents read/write on that repository.
GITHUB_BACKUP_REPOSITORY=
GITHUB_BACKUP_RETENTION_DAYS=30
GITHUB_TOKEN=
AGE_RECIPIENT=
