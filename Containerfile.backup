FROM docker.io/library/postgres:18.4-bookworm@sha256:1961f96e6029a02c3812d7cb329a3b03a3ac2bb067058dec17b0f5596aca9296
ARG VERSION=dev
ARG REVISION=unknown
ARG CREATED=unknown
LABEL org.opencontainers.image.title="ZestMem Backup" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.source="https://github.com/Bytelope/zestmem" \
      org.opencontainers.image.licenses="LicenseRef-Proprietary"
RUN rm /usr/local/bin/gosu && apt-get update && apt-get install -y --no-install-recommends age ca-certificates curl jq && rm -rf /var/lib/apt/lists/*
COPY ops/backup.sh /usr/local/bin/backup.sh
COPY ops/restore-test.sh /usr/local/bin/restore-test.sh
COPY ops/backup-loop.sh /usr/local/bin/backup-loop.sh
COPY ops/github-upload.sh /usr/local/bin/github-upload.sh
RUN chmod 0755 /usr/local/bin/backup.sh /usr/local/bin/restore-test.sh /usr/local/bin/backup-loop.sh /usr/local/bin/github-upload.sh
CMD ["/usr/local/bin/backup-loop.sh"]
